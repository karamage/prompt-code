{
  "name": "prompt-code",
  "version": "0.1.0",
  "description": "A markdown editor and snippet manager for AI prompts",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run build:client && bun src/server/index.ts",
    "dev:server": "bun --watch src/server/index.ts --port 4721",
    "dev:client": "vite",
    "build:client": "vite build",
    "build:server": "bun scripts/build-server.ts",
    "build": "bun run build:client && bun run build:server",
    "tauri": "tauri",
    "app:dev": "bun run build && tauri dev",
    "app:build": "bun run build && tauri build --bundles app",
    "app:dmg": "bun run build && tauri build --bundles dmg",
    "app:build:universal": "bun run build:client && bun scripts/build-server.ts universal-apple-darwin && tauri build --target universal-apple-darwin --bundles app",
    "release:mac": "bun scripts/release-mac.ts",
    "release:appstore": "bun scripts/release-appstore.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "biome format --write .",
    "check": "bun run typecheck && bun run lint && biome format . && bun test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "dompurify": "^3.4.17",
    "hono": "^4.13.13",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
